-- parametri con valore di default: dichiarazione, chiamata senza argomenti e con argomento

proc p3(int i:=100)
  ? i
end

p3()
p3(7)

-- caso misto posizionale: solo i primi parametri passati, gli altri prendono il default

proc p(int a, int b:=10, int c:=20)
  ? a,' ',b,' ',c
end

p(1)

-- default che referenzia un parametro precedente

proc q(int a, int b:=a*2)
  ? a,' ',b
end

q(5)

-- default che non deve mai essere valutato: referenzia un nome inesistente, ma la
-- chiamata passa sempre il parametro

proc r(int i:=nome_inesistente)
  ? i
end

r(42)

? '------------ arrivato alla fine ------------'

