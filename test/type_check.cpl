/*

   check di tipo: le assegnazioni compatibili passano. I rami del check
   che invece devono rifiutare (tipo errato, nil in un tipo NOT, parametri
   passati col tipo sbagliato) saltano i test automatici: una assegnazione
   rifiutata interrompe il programma, quindi non e' confrontabile col .out
   di una sola esecuzione. La verifica dei rifiuti resta a mano:

   var int i := 5      /  i := "pippo"      -> il valore pippo non e' compatibile con il tipo int
   var int i := "pippo"                     -> idem, all'inizializzazione
   var int not ni      /  ni := nil         -> il valore nil non e' compatibile con il tipo not int
   func int f(int x)   /  f("a")            -> il valore a non e' compatibile con il tipo int
   func int f(int not x) / f(nil)           -> il valore nil non e' compatibile con il tipo not int
   func int f()        /  result:="pippo"   -> result: il valore pippo non e' compatibile con il tipo int

*/

// --- tipi di base: inizializzazione e assegnazione
var int i := 5
? "i=",i
i := 7
? "i=",i

var str s := "pippo"
? "s=",s

// --- tipi composti
var array[int] a := [1,2,3]
? "a=",a

// --- tipo unione: vale una qualsiasi delle alternative
var int|str x := "ok"
? "x=",x
x := 42
? "x=",x

// --- any (?) e senz'altro nell'assegnazione
var ? v := 1
? "v=",v
v := "ciao"
? "v=",v

// --- senza NOT il tipo definito accetta anche nil
var int n
n := nil
? "n=",n

// --- tipo NOT: rifiuta il nil, accetta il resto
var int not ni
ni := 10
? "ni=",ni

// --- proc e func: parametri controllati alla chiamata, nome legato alla firma
func int doppio(int x)
  result:=x+x
end
? "doppio(6)=",doppio(6)

func str saluto(str nome)
  result:="ciao "+nome
end
? "saluto=",saluto("gina")

// --- result: il valore assegnato deve stare nel tipo di ritorno della func
func int|str segno(int x)
  if x>0
    result:=x
  else
    result:="zero"
  end
end
? "segno(3)=",segno(3)
? "segno(0)=",segno(0)

func int vuota()
  result:=nil
end
? "vuota()=",vuota()

func ? qualsiasi()
  result:="ciao"
end
? "qualsiasi()=",qualsiasi()

// --- variabile func: il tipo dichiarato e' la firma, il valore e' la func
var (int:(int)) g := doppio
? "g(9)=",g(9)
g := doppio
? "g(8)=",g(8)
