/*

  File che accumula le cose da fare
  
  Deve compilare e non eseguire, via via faccio quelo che esegue svuotandolo
   
*/

var int i
i:="pippo"
? "i=",i


// prove di compilazioni con i tipi dipendenti

type int with (this>=0) positive  // dichiarazione di tipo

var positive pp

var int with this<0  jj  // tipo limitato in linea

func str! read(File with (status=Opened) f) // funzione con parametro con tipo limitato
end

var str with this<>nil s // variabile stringa che non può essere nil


// array comprehension
[x for each x in [1,2,3] with pari(x)]
[x for each x,k in [1,2,3] with pari(x)]

  
// dict comprehension
{k:x for each k,x in ["alfa","beta","gamma"]}
{k:x for each k,x in ["alfa","beta","gamma"] with pari(k)}
{k:x for each k:x in ["alfa","beta","gamma"] : [1,2,3]}
{k:x for each k:x in ["alfa","beta","gamma"] : [1,2,3] with pari(x)}
