/*
  Primi passi con le classi e le istanze
  
  TODO:
  1. func/proc di istanza
  2. clonazione degli oggetti quando portati dalla classe all'istanza per evitare di modificare dall'istanza gli oggetti di classe composti come array e dizionari
  3. func/proc di classe, si deve vedere! ... o sono solo nel contenitore (modulo di modulo)?
  5. classi nella lista dei tipi di modulo

  DONE:
  4. store prima di load
  
*/
  
var ? a:=[1,2,3]
  
class ccc
  var int i,j,k:=100
  proc p()
    ? 'i:',i,' a:',a
    i:=i+1
  end
end

? ccc
ccc.i:=10
? 'cccc.i=',ccc.i,' cccc.k=',ccc.k,' ccc.p=',ccc.p
ccc.p()
ccc.p()

var ? c:=ccc()
? 'c:',c,'=<instance of ccc> ()'
? 'c.i:',c.i,'=12'                 // qui crea l'oggetto lazy "i" nell'istanza
c.i:=100                           // qui assegna all'oggetto lazy "i" che è già stato creato nell'instanza quando è stato letto
c.j:=200                           // qui crea l'oggetto lazy "j" che non era mai stato letto nell'istanza 
? 'c.i:',c.i,'=100 ccc.i:',ccc.i,'=12 c.j:',c.j,'=200'
? 'c.p:',c.p,'=<meth p() -- pcode>'
c.p()                              // siccome non esiste ancora la procedura legata all'istanza, questa chiamata si comporta come se fosse di classe ERRORE
? 'c.i:',c.i,'=101 ccc.i:',ccc.i,'=12'
? c

